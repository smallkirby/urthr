# Minimal aarch64 userland for testing Urthr OS.

BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_STATIC_LIBS=n
BR2_TARGET_ROOTFS_TAR=y
BR2_ENABLE_DEBUG=y
BR2_DEBUG_2=y
BR2_STRIP_strip=n

BR2_TARGET_GENERIC_HOSTNAME="buildroot"
BR2_TARGET_GENERIC_ISSUE="Welcome to Buildroot in UrthrOS"
BR2_TARGET_GENERIC_ROOT_PASSWD=""

BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(URTHR_BUSYBOX_CONFIG)"
